# Render define NODE_ENV=production también durante el build y, con esa
# variable, npm omite las devDependencies. El servidor compila TypeScript antes
# de arrancar: sin ellas se queda sin compilador y sin @types/node, y el build
# termina en «error TS2688: Cannot find type definition file for 'node'».
#
# Esto lo instala todo sin depender de cómo esté configurado el comando de
# build en el panel. El precio es que las herramientas de desarrollo quedan en
# node_modules del servidor, que en disco no molesta y en ejecución no se carga.
include=dev
