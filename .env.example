# ─────────────────────────────────────────────────────────────
# INOCARNE — backend environment
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development
PORT=4000

# Zona horaria en la que se muestran las fechas (Bolivia = UTC-4).
# Los registros se guardan siempre en UTC; esto solo afecta la presentación.
DISPLAY_TIMEZONE=America/La_Paz

# ── MongoDB ──────────────────────────────────────────────────
# Cadena de conexión de MongoDB Atlas.
# Ejemplo: mongodb+srv://usuario:clave@cluster.xxxxx.mongodb.net/inocarne
MONGODB_URI=

# ── Autenticación ────────────────────────────────────────────
# Clave secreta para firmar los JSON Web Token.
# Generar una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── Cloudinary (almacenamiento de fotografías) ───────────────
# Si se dejan en blanco la aplicación funciona igual, pero los
# endpoints de subida de imágenes responderán que no está configurado.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=inocarne

# ── Tareas programadas ───────────────────────────────────────
# Clave que debe enviar el servicio de cron externo en la cabecera
# x-cron-secret para poder ejecutar la evaluación de alertas.
CRON_SECRET=
